# Шаблон змінних середовища.
# Скопіюй у .env і заповни справжніми значеннями.
# .env у .gitignore — у репозиторій потрапляє ТІЛЬКИ цей файл із заглушками.

# Ключ Anthropic API — потрібен, щоб запускати Claude Code всередині контейнера
ANTHROPIC_API_KEY=sk-ant-...

# Часовий пояс для контейнера
TZ=Europe/Kyiv

# Рівень логування застосунку (debug, info, warn, error)
LOG_LEVEL=info
