# .env.example — зразок змінних оточення. Реальний .env у git НЕ потрапляє.
#
# Як користуватись: скопіювати цей файл у .env і підставити свої значення.
#
# ⚠️ ВАЖЛИВО ПРО БЕЗПЕКУ
# Vite вшиває всі змінні з префіксом VITE_ прямо у зібраний файл, який
# завантажує браузер. Тобто будь-хто може їх прочитати, відкривши код сторінки.
# Секрети (паролі, ключі API, токени) сюди класти НЕ МОЖНА.
#
# Зараз секретів і немає: застосунок працює без сервера, дані живуть
# у браузері (ADR-0003). Файл існує як місце для майбутніх налаштувань.

# Назва застосунку у вкладці браузера
VITE_APP_TITLE=ПЛАН

# Ключ у localStorage, під яким зберігаються дані.
# Змінюй, якщо треба тримати кілька незалежних наборів даних (напр. тестовий і робочий).
VITE_STORAGE_NAMESPACE=plan
