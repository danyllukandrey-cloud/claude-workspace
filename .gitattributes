# Windows за замовчуванням переводить кінці рядків у CRLF.
# Для bash-скриптів це смертельно: у Linux-контейнері вони просто не запустяться.
# Тут примусово фіксуємо LF для всього, що виконується всередині контейнера.

*.sh text eol=lf
.githooks/* text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
