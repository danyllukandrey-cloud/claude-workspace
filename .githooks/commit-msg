#!/bin/sh
#
# commit-msg — перевіряє мітку Decision у повідомленні коміту, (D-92) звіряє
# рішення з файлами фічі, яку воно стосується, і (D-101) звіряє SDD-Task
# із tracker.md задачі.
#
# Навіщо: реєстр рішень (docs/DECISIONS.md) і історія Git зв'язані рядком
# "Decision: D-NN". Зв'язок тримається на пам'яті людини, а забуту мітку
# заднім числом уже не вписати — повідомлення коміту незмінне. Той самий
# принцип поширено на задачі (SDD-Task -> tracker.md, D-101) — обіцянка
# протоколу skill-а теж тримається на пам'яті в моменті, а не звірена.
#
# Правило цілком: CLAUDE.md § Рішення і зміни (D-19, D-20, D-92, D-101)
#
# Обійти: git commit --no-verify   (це поручні, не замок)

MSG_FILE="$1"
ROOT=$(git rev-parse --show-toplevel)
REGISTRY="$ROOT/docs/DECISIONS.md"

# Прибрати коментарі (#) і можливі CRLF, які лишає Windows
CLEAN=$(git stripspace --strip-comments < "$MSG_FILE" | tr -d '\r')

# --- Технічні коміти пропускаємо без перевірки -------------------------------
# Merge — повідомлення генерує сам Git; fixup!/squash! — службові коміти,
# які rebase згодом вливає в батьківський (мітка вже є там).
case "$CLEAN" in
	"Merge "*|"fixup!"*|"squash!"*|"Revert "*) exit 0 ;;
esac

# Порожнє повідомлення — хай Git сам його відхилить своєю звичною помилкою
if [ -z "$CLEAN" ]; then
	exit 0
fi

# --- Дістати мітки --------------------------------------------------------
# Саме interpret-trailers, а не grep: він бачить трейлери так само, як їх
# потім бачитиме `git log --format=%(trailers:...)`. Якщо мітка відділена
# порожнім рядком, вона сюди НЕ потрапить — і це навмисне, ми хочемо
# зловити цю помилку зараз, а не через півроку при пошуку.
VALUES=$(printf '%s\n' "$CLEAN" \
	| git interpret-trailers --parse \
	| sed -n 's/^[Dd]ecision:[[:space:]]*//p')

# Наступний вільний номер рішення.
# Рахуємо максимум, а не кількість рядків: таблиця в реєстрі не відсортована
# (D-20 стоїть перед D-19), тож «останній рядок» дав би неправильну відповідь.
next_decision() {
	if [ ! -f "$REGISTRY" ]; then
		echo "D-?"
		return
	fi
	MAX=$(grep -oE '^\| D-[0-9]+' "$REGISTRY" | grep -oE '[0-9]+' | sort -n | tail -1)
	if [ -z "$MAX" ]; then
		MAX=0
	fi
	echo "D-$((MAX + 1))"
}

fail_header() {
	echo ""
	echo "❌ Коміт не пройшов."
	echo ""
}

fail_footer() {
	echo ""
	echo "   Повне правило: CLAUDE.md § Рішення і зміни"
	echo "   Обійти разово: git commit --no-verify"
	echo ""
}

# --- Мітки немає ----------------------------------------------------------
if [ -z "$VALUES" ]; then
	fail_header
	# Окремий випадок: рядок є, але відділений порожнім рядком від решти міток.
	# Найчастіша помилка — і найпідступніша, бо очима все виглядає правильно.
	if printf '%s\n' "$CLEAN" | grep -qi '^[Dd]ecision:'; then
		echo "   Рядок Decision: у повідомленні Є, але Git його не бачить."
		echo ""
		echo "   Причина: блоком міток вважається ЛИШЕ останній абзац."
		echo "   Перед Decision: стоїть порожній рядок — прибери його, щоб"
		echo "   мітка стояла впритул до сусідніх (Co-Authored-By тощо)."
		echo ""
		echo "   Правильно:                     Неправильно:"
		echo "       тіло повідомлення              тіло повідомлення"
		echo "                                      "
		echo "       Decision: D-19                 Decision: D-19"
		echo "       Co-Authored-By: ...                                  <- порожній рядок"
		echo "                                      Co-Authored-By: ..."
	else
		echo "   У повідомленні немає мітки Decision."
		echo ""
		echo "   Додай ОСТАННІМ блоком повідомлення один із варіантів:"
		echo ""
		echo "       Decision: D-NN     <- номер рішення з docs/DECISIONS.md"
		echo "                             наступний вільний: $(next_decision)"
		echo "       Decision: none     <- рішення тут немає: правопис, форматування,"
		echo "                             дрібне прибирання"
		echo ""
		echo "   Слово none номер не витрачає: наступний вільний лишається вільним."
		echo ""
		echo "   Немає потрібного рішення в реєстрі? Спочатку впиши рядок у"
		echo "   docs/DECISIONS.md, потім повтори коміт. Реєстр веде рішення —"
		echo "   коміт лише посилається на нього."
	fi
	fail_footer
	exit 1
fi

# --- Мітки є: перевірити кожну -------------------------------------------
for VALUE in $VALUES; do

	# Свідома відповідь «рішення тут немає»
	if [ "$VALUE" = "none" ]; then
		continue
	fi

	# Формат номера
	if ! printf '%s' "$VALUE" | grep -qE '^D-[0-9]+$'; then
		fail_header
		echo "   Мітка «Decision: $VALUE» незрозуміла."
		echo ""
		echo "   Очікується або номер вигляду D-19, або слово none."
		fail_footer
		exit 1
	fi

	# Реєстр на місці?
	if [ ! -f "$REGISTRY" ]; then
		fail_header
		echo "   Не знайдено docs/DECISIONS.md — нема де перевірити $VALUE."
		fail_footer
		exit 1
	fi

	# Рішення справді існує?
	if ! grep -q "^| $VALUE |" "$REGISTRY"; then
		fail_header
		echo "   Рішення $VALUE не знайдено в docs/DECISIONS.md."
		echo ""
		echo "   Або одрук у номері, або рішення ще не записане."
		echo "   Наступний вільний номер: $(next_decision)"
		echo ""
		echo "   Порядок такий: спочатку рядок у реєстрі — потім коміт."
		echo "   Рішення існує раніше за зміну, а не навпаки."
		fail_footer
		exit 1
	fi
done

# --- D-92: звірка рішення з файлами фічі, яку воно стосується -------------
# Мітка вже правильна (пройшли перевірку вище). Тепер дивимось, чи не забули
# зв'язати рішення з фічею, якої воно реально стосується — правило описане
# в CLAUDE.md § Звірка з фічею.

STAGED=$(git diff --cached --name-only)

# Слаги фіч, чиї файли реально змінені в ЦЬОМУ коміті (з diff, не здогадка).
TOUCHED_SLUGS=$(printf '%s\n' "$STAGED" \
	| grep -oE '^docs/features/[^/]+/' \
	| sed -E 's#^docs/features/##; s#/$##' \
	| sort -u)

# Слаги, на які посилається (features/<slug>) хоч одне валідне Decision: D-NN
# із цього коміту — дивимось повний рядок реєстру, не лише номер.
MENTIONED_SLUGS=""
for VALUE in $VALUES; do
	[ "$VALUE" = "none" ] && continue
	ROW=$(grep "^| $VALUE |" "$REGISTRY")
	ROW_SLUGS=$(printf '%s\n' "$ROW" | grep -oE 'features/[a-zA-Z0-9_-]+' | sed -E 's#^features/##')
	MENTIONED_SLUGS=$(printf '%s\n%s\n' "$MENTIONED_SLUGS" "$ROW_SLUGS")
done
MENTIONED_SLUGS=$(printf '%s\n' "$MENTIONED_SLUGS" | sed '/^$/d' | sort -u)

# Чи є в цьому коміті хоч одне реальне (не "none") Decision?
HAS_REAL_DECISION=0
for VALUE in $VALUES; do
	[ "$VALUE" != "none" ] && HAS_REAL_DECISION=1
done

# --- Блокуюча перевірка: файли фічі змінені, жодне рішення на неї не посилається
# Спирається на реальний diff коміту, тому хибних спрацювань майже нема — безпечно блокувати.
if [ "$HAS_REAL_DECISION" = "1" ] && [ -n "$TOUCHED_SLUGS" ]; then
	MISSING=""
	for SLUG in $TOUCHED_SLUGS; do
		if ! printf '%s\n' "$MENTIONED_SLUGS" | grep -qx "$SLUG"; then
			MISSING="$MISSING $SLUG"
		fi
	done
	if [ -n "$MISSING" ]; then
		fail_header
		echo "   Цей коміт міняє файли фічі(-ей):$MISSING — але жодне Decision:"
		echo "   D-NN у повідомленні на цю фічу не посилається (колонка «Деталі»"
		echo "   в docs/DECISIONS.md без \`features/<slug>\`)."
		echo ""
		echo "   Додай посилання features/<slug>/... у рядок D-NN в реєстрі,"
		echo "   або, якщо коміт справді про іншу фічу — уточни, яке з Decision"
		echo "   міток стосується цих файлів."
		fail_footer
		exit 1
	fi
fi

# --- М'яке попередження: рішення посилається на фічу, ключові файли не мінялись
# Тут хибні спрацювання можливі (рішення буває навмисно відкладене) — тому лише
# попереджаємо, коміт усе одно проходить.
CORE_FILES="spec.md data-model.md tasks.json test-plan.md"
WARNED=0
for VALUE in $VALUES; do
	[ "$VALUE" = "none" ] && continue
	ROW=$(grep "^| $VALUE |" "$REGISTRY")
	ROW_SLUGS=$(printf '%s\n' "$ROW" | grep -oE 'features/[a-zA-Z0-9_-]+' | sed -E 's#^features/##' | sort -u)
	for SLUG in $ROW_SLUGS; do
		FOUND=0
		for F in $CORE_FILES; do
			if printf '%s\n' "$STAGED" | grep -qx "docs/features/$SLUG/$F"; then
				FOUND=1
			fi
		done
		if [ "$FOUND" = "0" ]; then
			if [ "$WARNED" = "0" ]; then
				echo ""
				echo "⚠️  Попередження (не блокує) — CLAUDE.md § Звірка з фічею:"
				WARNED=1
			fi
			echo "   $VALUE посилається на features/$SLUG, але spec.md/data-model.md/"
			echo "   tasks.json/test-plan.md цієї фічі в коміті не мінялись."
			echo "   Навмисно (рішення відкладене)? Ігноруй. Ні? /pm-end зловить,"
			echo "   але дешевше виправити зараз."
		fi
	done
done
[ "$WARNED" = "1" ] && echo ""

# --- D-101: SDD-Task <-> tracker.md -----------------------------------------
# Крок 9 протоколу skill-а sdd:implement (Definition of Done) обіцяє: коміт,
# що завершує задачу, тим самим комітом оновлює tasks/tracker.md -> done.
# Знайдено 2026-09-05 (ISS-20): коміти T9 (58ad01a, 16220a9) несуть трейлер
# SDD-Task: T9, але tracker.md жодного разу не торкнулись -- обіцянка була
# лише текстом протоколу, ніхто її не звіряв у моменті. Той самий підхід, що
# й D-92 вище, застосований до задач замість рішень.
#
# Свідомо НЕ перевіряємо тут per-task .md файл (tasks/t<id>-*.md) --
# чи його теж має оновлювати `implement`, лишається відкритим питанням
# самого ISS-20; хук звіряє лише те, що DoD skill-а обіцяє явно.

SDD_TASK_VALUES=$(printf '%s\n' "$CLEAN" \
	| git interpret-trailers --parse \
	| sed -n 's/^SDD-[Tt]ask:[[:space:]]*//p' \
	| sort -u)

for TASK_ID in $SDD_TASK_VALUES; do
	# Формат неочікуваний -- не вгадуємо, пропускаємо мовчки
	printf '%s' "$TASK_ID" | grep -qE '^[A-Za-z0-9_-]+$' || continue

	# У яких tasks.json взагалі є задача з таким id?
	CANDIDATE_SLUGS=""
	for TJ in "$ROOT"/docs/features/*/tasks.json; do
		[ -f "$TJ" ] || continue
		if grep -q "\"id\":[[:space:]]*\"$TASK_ID\"" "$TJ"; then
			CANDIDATE_SLUGS="$CANDIDATE_SLUGS $(basename "$(dirname "$TJ")")"
		fi
	done

	if [ -z "$CANDIDATE_SLUGS" ]; then
		echo ""
		echo "⚠️  Попередження (не блокує): SDD-Task: $TASK_ID не знайдено в"
		echo "   жодному docs/features/*/tasks.json -- одруківка чи tasks.json"
		echo "   уже змінився?"
		continue
	fi

	# Код фічі лежить поза docs/features/ (plan/app/src/...), тож із кандидатів
	# лишаємо ті, чий слаг реально зустрічається серед застейджених шляхів.
	CONFIRMED_SLUGS=""
	for SLUG in $CANDIDATE_SLUGS; do
		if printf '%s\n' "$STAGED" | grep -q "/$SLUG/"; then
			CONFIRMED_SLUGS="$CONFIRMED_SLUGS $SLUG"
		fi
	done

	if [ -z "$CONFIRMED_SLUGS" ]; then
		echo ""
		echo "⚠️  Попередження (не блокує): SDD-Task: $TASK_ID є в tasks.json"
		echo "   ($CANDIDATE_SLUGS), але жоден шлях коміту не вказує однозначно"
		echo "   на цю фічу -- перевір tracker.md вручну."
		continue
	fi

	MISSING_TRACKER=""
	for SLUG in $CONFIRMED_SLUGS; do
		if ! printf '%s\n' "$STAGED" | grep -qx "docs/features/$SLUG/tasks/tracker.md"; then
			MISSING_TRACKER="$MISSING_TRACKER $SLUG"
		fi
	done

	if [ -n "$MISSING_TRACKER" ]; then
		fail_header
		echo "   Коміт завершує SDD-Task: $TASK_ID (фіча(-і):$MISSING_TRACKER),"
		echo "   але docs/features/<slug>/tasks/tracker.md у цьому коміті не"
		echo "   змінювався."
		echo ""
		echo "   Протокол skill-а sdd:implement (крок 9, Definition of Done)"
		echo "   вимагає оновити рядок $TASK_ID у tracker.md -> done в тому ж"
		echo "   коміті, що завершує задачу."
		echo ""
		echo "   Онови tracker.md і повтори коміт (git commit --amend, якщо"
		echo "   коміт іще нікуди не пішов далі)."
		fail_footer
		exit 1
	fi
done

exit 0
